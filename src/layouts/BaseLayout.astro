---
import '~/styles/global.css';
import SeoHead from '~/components/shared/SeoHead.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Optional LCP image to preload from <head> (e.g. "/queens/yvonne_kofigah.jpg") */
  preloadImage?: string;
}
const { title, description, ogImage, preloadImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#050111" />
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <SeoHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <slot />
    <script>
      import { initLenis } from '~/lib/motion/lenis';
      initLenis();
    </script>
  </body>
</html>

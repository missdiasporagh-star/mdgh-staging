---
import '~/styles/global.css';
import SeoHead from '~/components/shared/SeoHead.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#050111" />
    <SeoHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <slot />
    <script>
      import { initLenis } from '~/lib/motion/lenis';
      initLenis();
    </script>
  </body>
</html>

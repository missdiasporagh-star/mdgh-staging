---
import BaseLayout from './BaseLayout.astro';
import TopNav from '~/components/layout/TopNav.astro';
import Footer from '~/components/layout/Footer.astro';
import CulturalGreeting from '~/components/layout/CulturalGreeting.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Optional LCP image to preload from <head> */
  preloadImage?: string;
}
const { title, description, ogImage, preloadImage } = Astro.props;
---
<BaseLayout title={title} description={description} ogImage={ogImage} preloadImage={preloadImage}>
  <CulturalGreeting />
  <TopNav />
  <main id="main"><slot /></main>
  <Footer />
</BaseLayout>

<style is:global>
  main#main {
    min-height: calc(100vh - 80px);
  }
</style>

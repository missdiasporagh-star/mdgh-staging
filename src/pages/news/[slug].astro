---
import PageLayout from '~/layouts/PageLayout.astro';
import { getPressArticle } from '~/lib/content/queries';

const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const article = await getPressArticle(slug);
if (!article) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (article.data.externalUrl) {
  return Astro.redirect(article.data.externalUrl, 302);
}

const { Content } = await article.render();
const data = article.data;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<PageLayout title={data.title} description={data.excerpt} ogImage={data.coverImage}>
  <article style="max-width:760px;margin:var(--space-7) auto;padding:0 var(--space-5)">

    <a
      class="news-back"
      href="/news"
      style="font-family:var(--font-mono);font-size:var(--fs-meta);letter-spacing:0.2em;text-transform:uppercase;color:var(--color-saffron);text-decoration:none;display:inline-block;margin-bottom:var(--space-6)"
    >
      &larr; Back to Newsroom
    </a>

    <header style="margin:0 0 var(--space-7)">
      <p style="font-family:var(--font-mono);font-size:var(--fs-meta);letter-spacing:0.25em;text-transform:uppercase;color:var(--color-text-3);margin:0 0 var(--space-3)">
        {data.source ?? 'MDGH'} · {fmt(data.publishedAt)}
      </p>
      <h1 style="font-family:var(--font-display);font-size:clamp(36px,5vw,56px);font-weight:500;line-height:1.1;margin:0 0 var(--space-5)">
        {data.title}
      </h1>
      <p style="color:var(--color-text-2);font-size:var(--fs-body-l);line-height:1.6;margin:0">
        {data.excerpt}
      </p>
    </header>

    {data.coverImage && (
      <figure style="margin:0 0 var(--space-7);border-radius:var(--r-lg);overflow:hidden;background:linear-gradient(135deg,var(--color-deep-violet),var(--color-surface));border:1px solid var(--border-subtle);aspect-ratio:16/9">
        <img
          src={data.coverImage}
          alt={data.coverImageAlt ?? ''}
          loading="lazy"
          decoding="async"
          style="width:100%;height:100%;object-fit:cover;display:block"
        />
      </figure>
    )}

    <section class="prose">
      <Content />
    </section>
  </article>
</PageLayout>

<style>
  .news-back {
    transition: color var(--dur-fast) var(--ease-std);
  }
  .news-back:hover,
  .news-back:focus-visible {
    color: var(--color-text-1);
  }
  @media (prefers-reduced-motion: reduce) {
    .news-back {
      transition: none;
    }
  }
</style>

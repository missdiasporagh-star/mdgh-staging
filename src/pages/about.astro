---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroStrip from '~/components/ui/HeroStrip.astro';
import { getPage } from '~/lib/content/queries';

const entry = await getPage('about');
if (!entry) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { Content } = await entry.render();
const data = entry.data;
const hasLeadership = Array.isArray(data.leadership) && data.leadership.length > 0;
---
<PageLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.introduction}
>
  <article style="max-width:1200px;margin:48px auto;padding:0 24px">

    <HeroStrip eyebrow={data.eyebrow ?? 'Our Story'}>
      {data.headline && (
        <h1 style="font-family:var(--font-display);font-size:clamp(48px,7vw,80px);font-weight:500;line-height:1.05;margin:24px 0 16px;max-width:900px;position:relative;z-index:1">
          {data.headline}
        </h1>
      )}
      {data.introduction && (
        <p style="color:var(--color-text-2);font-size:var(--fs-body-l);max-width:640px;line-height:1.6;position:relative;z-index:1">
          {data.introduction}
        </p>
      )}
    </HeroStrip>

    {data.heroImage && (
      <figure style="margin:48px 0;border-radius:var(--r-lg);overflow:hidden;background:linear-gradient(135deg,var(--color-deep-violet),var(--color-surface));border:1px solid var(--border-subtle);aspect-ratio:16/9">
        <img
          src={data.heroImage}
          alt={data.heroImageAlt ?? ''}
          loading="lazy"
          decoding="async"
          style="width:100%;height:100%;object-fit:cover;display:block"
          onerror="this.style.display='none'"
        />
      </figure>
    )}

    <section class="prose" style="max-width:760px;margin:48px auto">
      <Content />
    </section>

    {hasLeadership && (
      <section style="margin:96px 0 32px">
        <p style="font-family:var(--font-mono);font-size:var(--fs-meta);letter-spacing:0.25em;text-transform:uppercase;color:var(--color-saffron);margin:0 0 8px">
          The People
        </p>
        <h2 style="font-family:var(--font-display);font-size:36px;font-weight:500;margin:0 0 32px;line-height:1.15">
          Leadership
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
          {data.leadership!.map((p) => (
            <article style="background:var(--color-bg-raised);border:1px solid var(--border-subtle);border-radius:var(--r-lg);overflow:hidden;transition:transform var(--dur-base) var(--ease-emp),border-color var(--dur-base) var(--ease-emp)">
              <div style="aspect-ratio:5/6;background:linear-gradient(135deg,var(--color-deep-violet),var(--color-surface));position:relative">
                {p.photo && (
                  <img
                    src={p.photo}
                    alt={p.photoAlt ?? p.name}
                    loading="lazy"
                    decoding="async"
                    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
                    onerror="this.style.display='none'"
                  />
                )}
              </div>
              <div style="padding:24px">
                <p style="font-family:var(--font-mono);font-size:var(--fs-meta);letter-spacing:0.2em;text-transform:uppercase;color:var(--color-saffron);margin:0 0 6px">
                  {p.role}
                </p>
                <h3 style="font-family:var(--font-display);font-size:24px;font-weight:500;margin:0 0 12px;line-height:1.2">
                  {p.name}
                </h3>
                {p.bio && (
                  <p style="color:var(--color-text-2);font-size:15px;line-height:1.6;margin:0">
                    {p.bio}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</PageLayout>

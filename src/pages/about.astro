---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroStrip from '~/components/ui/HeroStrip.astro';
import { getPage } from '~/lib/content/queries';

const entry = await getPage('about');
if (!entry) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { Content } = await entry.render();
const data = entry.data;
const hasLeadership = Array.isArray(data.leadership) && data.leadership.length > 0;
---
<PageLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.introduction}
>
  <article style="max-width:1200px;margin:var(--space-7) auto;padding:0 var(--space-5)">

    <HeroStrip eyebrow={data.eyebrow ?? 'Our Story'}>
      {data.headline && (
        <h1 style="font-family:var(--font-display);font-size:clamp(48px,7vw,80px);font-weight:500;line-height:1.05;margin:var(--space-5) 0 var(--space-4);max-width:900px;position:relative;z-index:1">
          {data.headline}
        </h1>
      )}
      {data.introduction && (
        <p style="color:var(--color-text-2);font-size:var(--fs-body-l);max-width:640px;line-height:1.6;position:relative;z-index:1">
          {data.introduction}
        </p>
      )}
    </HeroStrip>

    {data.heroImage && (
      <figure style="margin:var(--space-7) 0;border-radius:var(--r-lg);overflow:hidden;background:linear-gradient(135deg,var(--color-deep-violet),var(--color-surface));border:1px solid var(--border-subtle);aspect-ratio:16/9">
        <img
          src={data.heroImage}
          alt={data.heroImageAlt ?? ''}
          loading="lazy"
          decoding="async"
          style="width:100%;height:100%;object-fit:cover;display:block"
          onerror="this.style.display='none'"
        />
      </figure>
    )}

    <section class="prose" style="max-width:760px;margin:var(--space-7) auto">
      <Content />
    </section>

    {hasLeadership && (
      <section style="margin:var(--space-9) 0 var(--space-6)">
        {(data.leadershipEyebrow || data.leadershipHeading) && (
          <header style="margin-bottom:var(--space-6)">
            {data.leadershipEyebrow && (
              <p style="font-family:var(--font-mono);font-size:var(--fs-meta);letter-spacing:0.25em;text-transform:uppercase;color:var(--color-saffron);margin:0 0 var(--space-2)">{data.leadershipEyebrow}</p>
            )}
            {data.leadershipHeading && (
              <h2 style="font-family:var(--font-display);font-size:var(--fs-h2);font-weight:500;margin:0;line-height:1.15">{data.leadershipHeading}</h2>
            )}
          </header>
        )}
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--space-5)">
          {(data.leadership ?? []).map((p) => (
            <article style="background:var(--color-bg-raised);border:1px solid var(--border-subtle);border-radius:var(--r-lg);overflow:hidden">
              <div style="aspect-ratio:5/6;background:linear-gradient(135deg,var(--color-deep-violet),var(--color-surface));position:relative">
                {p.photo && (
                  <img
                    src={p.photo}
                    alt={p.photoAlt ?? p.name}
                    loading="lazy"
                    decoding="async"
                    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
                    onerror="this.style.display='none'"
                  />
                )}
              </div>
              <div style="padding:var(--space-5)">
                <p style="font-family:var(--font-mono);font-size:var(--fs-meta);letter-spacing:0.2em;text-transform:uppercase;color:var(--color-saffron);margin:0 0 var(--space-1)">
                  {p.role}
                </p>
                <h3 style="font-family:var(--font-display);font-size:var(--fs-h3);font-weight:500;margin:0 0 var(--space-3);line-height:1.2">
                  {p.name}
                </h3>
                {p.bio && (
                  <p style="color:var(--color-text-2);font-size:var(--fs-body);line-height:1.6;margin:0">
                    {p.bio}
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</PageLayout>

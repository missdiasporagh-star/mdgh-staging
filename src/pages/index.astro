---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Home">
  <main style="min-height: 100vh; display: grid; place-items: center; padding: 32px;">
    <div style="text-align: center; max-width: 720px;">
      <p style="font-family: var(--font-mono); font-size: 11px; letter-spacing: .25em; color: var(--color-saffron); text-transform: uppercase;">
        MDGH Platform · Foundation
      </p>
      <h1 style="font-family: var(--font-display); font-size: clamp(48px, 8vw, 96px); font-weight: 500; font-style: italic; margin: 24px 0 16px; background: linear-gradient(120deg, var(--color-bone), var(--color-saffron) 60%, var(--color-rose)); -webkit-background-clip: text; background-clip: text; color: transparent;">
        She wears the future.
      </h1>
      <p style="color: var(--color-text-2); font-size: 18px;">
        Staging environment. Build in progress.
      </p>
    </div>
  </main>
</BaseLayout>

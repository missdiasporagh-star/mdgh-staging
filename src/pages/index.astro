---
import PageLayout from '~/layouts/PageLayout.astro';
import HeroChapter from '~/components/home/HeroChapter.astro';
import MissionChapter from '~/components/home/MissionChapter.astro';
import CrownTeaserChapter from '~/components/home/CrownTeaserChapter.astro';
import DiasporaTeaserChapter from '~/components/home/DiasporaTeaserChapter.astro';
import CycleTeaserChapter from '~/components/home/CycleTeaserChapter.astro';
import BecomeHerChapter from '~/components/home/BecomeHerChapter.astro';
import ChapterRail from '~/components/home/ChapterRail';
import { home } from '~/data/home';
import { getAllQueens, getCurrentCycle, getContestantsByCycle, getAllCities } from '~/lib/content/queries';

const [allQueens, currentCycle, allCities] = await Promise.all([
  getAllQueens().catch(() => []),
  getCurrentCycle().catch(() => undefined),
  getAllCities().catch(() => []),
]);

const currentContestants = currentCycle ? await getContestantsByCycle(currentCycle.id).catch(() => []) : [];

const queens = allQueens.map((q) => ({
  id: q.id,
  name: q.data.name,
  heroImage: q.data.heroImage,
  year: q.data.year,
  crownNumber: q.data.crownNumber,
}));

const contestants = currentContestants.map((c) => ({
  id: c.id,
  name: c.data.name,
  slug: c.id,
  region: c.data.region,
  heroImage: c.data.heroImage,
}));
---
<PageLayout title={home.seoTitle} description={home.seoDescription}>
  <HeroChapter {...home.hero} />
  <MissionChapter {...home.mission} />
  <CrownTeaserChapter {...home.crownTeaser} queens={queens} />
  <DiasporaTeaserChapter {...home.diasporaTeaser} cityCount={allCities.length} />
  <CycleTeaserChapter {...home.cycleTeaser} contestants={contestants} />
  <BecomeHerChapter {...home.becomeHer} />
  <ChapterRail client:idle />
</PageLayout>

---
import { getCollection } from 'astro:content';
import Button from '~/components/ui/Button.astro';
import ContestantCard from '~/components/contestants/ContestantCard.astro';

type ContestantSummary = {
  id: string;
  name?: string;
  slug?: string;
  region?: string;
  heroImage?: string;
};

interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  cta?: { label?: string; href?: string; variant?: 'primary' | 'secondary' | 'ghost' };
  /** Backwards-compatible slim prop from index.astro — not used for rendering;
   *  the chapter re-fetches the full collection so ContestantCard receives all required fields. */
  contestants?: ContestantSummary[];
}

const { eyebrow, headline, body, cta } = Astro.props;

// Load current cycle + full contestant entries so ContestantCard has every field it needs.
const cycles = await getCollection('cycles');
const currentCycle = cycles.find((c) => c.data.status === 'current');
const cycleCrown = currentCycle?.data.crownNumber ?? '';

const allContestants = currentCycle ? await getCollection('contestants') : [];
const top3 = allContestants
  .filter((c) => c.data.cycle.id === currentCycle?.id)
  .sort(
    (a, b) =>
      (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0) ||
      a.data.name.localeCompare(b.data.name),
  )
  .slice(0, 3);
---

<section class="mdgh-cycle-teaser" data-chapter="cycle" aria-label="This cycle">
  <div class="mdgh-cycle-teaser__head">
    {eyebrow && <p class="mdgh-cycle-teaser__eyebrow">{eyebrow}</p>}
    {headline && <h2 class="mdgh-cycle-teaser__headline">{headline}</h2>}
    {body && <p class="mdgh-cycle-teaser__body">{body}</p>}
  </div>

  {top3.length > 0 && (
    <div class="cycle-teaser__mini-grid">
      {top3.map((c, i) => (
        <ContestantCard
          slug={c.slug ?? c.id}
          name={c.data.name}
          sashNumber={c.data.sashNumber}
          sortOrder={c.data.sortOrder}
          region={c.data.region}
          cycleCrown={cycleCrown}
          heroImage={c.data.heroImage}
          heroImageAlt={c.data.heroImageAlt ?? `${c.data.name}, Crown ${cycleCrown} contestant`}
          index={i}
        />
      ))}
    </div>
  )}

  {cta?.label && cta?.href && (
    <div class="mdgh-cycle-teaser__cta">
      <Button variant={cta.variant ?? 'secondary'} href={cta.href}>{cta.label}</Button>
    </div>
  )}
</section>

<style>
  .mdgh-cycle-teaser {
    min-height: 90vh;
    padding: var(--space-9) var(--space-6);
    background: linear-gradient(180deg, var(--color-obsidian), var(--color-deep-violet));
  }

  .mdgh-cycle-teaser__head {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .mdgh-cycle-teaser__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-saffron);
    margin: 0 0 var(--space-4);
  }

  .mdgh-cycle-teaser__headline {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 var(--space-4);
  }

  .mdgh-cycle-teaser__body {
    color: var(--color-text-2);
    font-size: var(--fs-body-l);
    max-width: 720px;
    margin: 0 auto;
  }

  .cycle-teaser__mini-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    max-width: 560px;
    margin: 24px auto 0;
  }

  @media (max-width: 767px) {
    .cycle-teaser__mini-grid {
      grid-template-columns: 1fr;
      max-width: 320px;
    }
  }

  .mdgh-cycle-teaser__cta {
    text-align: center;
    margin-top: var(--space-7);
  }
</style>

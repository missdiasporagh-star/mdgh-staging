---
import Button from '~/components/ui/Button.astro';
import MetaLabel from '~/components/ui/MetaLabel.astro';

type QueenSummary = {
  id: string;
  name?: string;
  heroImage?: string;
  year?: number;
  crownNumber?: number;
};

interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  cta?: { label?: string; href?: string; variant?: 'primary' | 'secondary' | 'ghost' };
  queens?: QueenSummary[];
}

const { eyebrow, headline, body, cta, queens = [] } = Astro.props;
const visibleQueens = queens.slice(0, 8);
const founder = queens.find((q) => q.crownNumber === 1) ?? queens[0];
---

<section class="mdgh-crown-teaser" data-chapter="crown" aria-label="The crown">
  <div class="mdgh-crown-teaser__intro">
    <div class="mdgh-crown-teaser__head">
      {eyebrow && <p class="mdgh-crown-teaser__eyebrow">{eyebrow}</p>}
      {headline && <h2 class="mdgh-crown-teaser__headline">{headline}</h2>}
      {body && <p class="mdgh-crown-teaser__body">{body}</p>}
    </div>

    {founder && founder.heroImage && (
      <aside class="crown-teaser__mini-card" aria-label={`Crown I — ${founder.name ?? 'Founder'}`}>
        <img
          src={founder.heroImage}
          alt={founder.name ? `${founder.name}, Crown I of Miss Diaspora Ghana` : 'Crown I founder portrait'}
          loading="lazy"
          decoding="async"
          class="crown-teaser__mini-img"
        />
        <div class="crown-teaser__mini-sash" aria-hidden="true">I</div>
        <div class="crown-teaser__mini-meta">
          <MetaLabel text={`${founder.year ?? ''} · CROWN I`} tone="accent" />
          <div class="crown-teaser__mini-name">{founder.name}</div>
        </div>
      </aside>
    )}
  </div>

  {visibleQueens.length > 0 && (
    <ul class="mdgh-crown-teaser__rail" role="list">
      {visibleQueens.map((q) => (
        <li class="mdgh-crown-teaser__card">
          {q.heroImage && <img src={q.heroImage} alt={q.name ?? ''} loading="lazy" decoding="async" />}
          <div class="mdgh-crown-teaser__cardmeta">
            <span class="mdgh-crown-teaser__num">№ {q.crownNumber ?? '—'}</span>
            <h3>{q.name}</h3>
            <span class="mdgh-crown-teaser__year">{q.year}</span>
          </div>
        </li>
      ))}
    </ul>
  )}

  {cta?.label && cta?.href && (
    <div class="mdgh-crown-teaser__cta">
      <Button variant={cta.variant ?? 'secondary'} href={cta.href}>{cta.label}</Button>
    </div>
  )}
</section>

<style>
  .mdgh-crown-teaser {
    min-height: 90vh;
    padding: var(--space-9) var(--space-6);
    background: linear-gradient(180deg, var(--color-deep-violet) 0%, var(--color-obsidian) 100%);
  }

  .mdgh-crown-teaser__intro {
    max-width: 1200px;
    margin: 0 auto var(--space-7);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 768px) {
    .mdgh-crown-teaser__intro {
      grid-template-columns: 1fr 220px;
    }
  }

  .mdgh-crown-teaser__head {
    text-align: left;
  }

  .mdgh-crown-teaser__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-saffron);
    margin: 0 0 var(--space-4);
  }

  .mdgh-crown-teaser__headline {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 var(--space-4);
  }

  .mdgh-crown-teaser__body {
    color: var(--color-text-2);
    font-size: var(--fs-body-l);
    max-width: 720px;
    margin: 0;
  }

  .crown-teaser__mini-card {
    position: relative;
    width: 200px;
    aspect-ratio: 3 / 4;
    background: linear-gradient(180deg, var(--color-deep-violet, #1a0833), var(--color-obsidian, #050111));
    border: 1px solid rgba(255, 209, 102, 0.4);
    border-radius: 14px;
    padding: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    justify-self: start;
  }
  @media (min-width: 768px) {
    .crown-teaser__mini-card {
      justify-self: end;
    }
  }
  .crown-teaser__mini-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.85;
  }
  .crown-teaser__mini-sash {
    position: relative;
    z-index: 2;
    font-family: 'Fraunces Variable', 'Fraunces', serif;
    font-style: italic;
    font-weight: 700;
    font-size: 56px;
    line-height: 0.85;
    color: rgba(255, 209, 102, 0.85);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6), 0 -1px 0 rgba(255, 250, 200, 0.2);
  }
  .crown-teaser__mini-meta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .crown-teaser__mini-name {
    font-family: 'Fraunces Variable', 'Fraunces', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 18px;
    line-height: 1;
    color: #fff;
  }

  .mdgh-crown-teaser__rail {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0 var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .mdgh-crown-teaser__card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--border-subtle);
    position: relative;
  }

  .mdgh-crown-teaser__card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .mdgh-crown-teaser__cardmeta {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mdgh-crown-teaser__num {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.25em;
    color: var(--color-saffron);
    text-transform: uppercase;
  }

  .mdgh-crown-teaser__cardmeta h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 500;
    margin: 0;
  }

  .mdgh-crown-teaser__year {
    color: var(--color-text-3);
    font-size: var(--fs-meta);
  }

  .mdgh-crown-teaser__cta {
    text-align: center;
    margin-top: var(--space-6);
  }
</style>

---
import Button from '~/components/ui/Button.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  cta?: { label?: string; href?: string; variant?: 'primary' | 'secondary' | 'ghost' };
  cityCount?: number;
}

const { eyebrow, headline, body, cta, cityCount = 0 } = Astro.props;
---

<section class="mdgh-diaspora-teaser" data-chapter="diaspora" aria-label="The diaspora">
  <div class="mdgh-diaspora-teaser__inner">
    <div class="mdgh-diaspora-teaser__copy">
      {eyebrow && <p class="mdgh-diaspora-teaser__eyebrow">{eyebrow}</p>}
      {headline && <h2 class="mdgh-diaspora-teaser__headline">{headline}</h2>}
      {body && <p class="mdgh-diaspora-teaser__body">{body}</p>}
      {cityCount > 0 && (
        <p class="mdgh-diaspora-teaser__stat">
          {cityCount}+ cities · 4 continents
        </p>
      )}
      {cta?.label && cta?.href && (
        <div class="mdgh-diaspora-teaser__cta">
          <Button variant={cta.variant ?? 'secondary'} href={cta.href}>{cta.label}</Button>
        </div>
      )}
    </div>
    <div class="mdgh-diaspora-teaser__viz" aria-hidden="true">
      <div class="mdgh-globe-stub"></div>
    </div>
  </div>
</section>

<style>
  .mdgh-diaspora-teaser {
    min-height: 90vh;
    padding: var(--space-9) var(--space-6);
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 70% at 70% 50%, rgba(255, 126, 179, 0.12), transparent 60%),
      var(--color-obsidian);
  }

  .mdgh-diaspora-teaser__inner {
    max-width: 1200px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .mdgh-diaspora-teaser__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-saffron);
    margin: 0 0 var(--space-4);
  }

  .mdgh-diaspora-teaser__headline {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 var(--space-4);
    text-align: left;
  }

  .mdgh-diaspora-teaser__body {
    color: var(--color-text-2);
    font-size: var(--fs-body-l);
    margin: 0;
    line-height: 1.6;
  }

  .mdgh-diaspora-teaser__stat {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-saffron);
    margin: var(--space-5) 0 0;
  }

  .mdgh-diaspora-teaser__cta {
    margin-top: var(--space-5);
  }

  .mdgh-diaspora-teaser__viz {
    display: grid;
    place-items: center;
  }

  .mdgh-globe-stub {
    width: clamp(280px, 35vw, 480px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 209, 102, 0.4), transparent 50%),
      radial-gradient(circle at 70% 60%, rgba(107, 43, 217, 0.6), transparent 60%),
      var(--color-deep-violet);
    box-shadow:
      inset 0 0 80px rgba(0, 0, 0, 0.5),
      0 0 120px rgba(107, 43, 217, 0.4);
    animation: mdgh-globe-spin 60s linear infinite;
  }

  @keyframes mdgh-globe-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .mdgh-diaspora-teaser__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mdgh-globe-stub {
      animation: none;
    }
  }
</style>

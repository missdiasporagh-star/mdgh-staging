---
import Button from '~/components/ui/Button.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  cta?: { label?: string; href?: string; variant?: 'primary' | 'secondary' | 'ghost' };
}

const { eyebrow, headline, body, cta } = Astro.props;
---

<section class="mdgh-become" data-chapter="become" aria-label="Become her">
  <div class="mdgh-become__inner">
    {eyebrow && <p class="mdgh-become__eyebrow">{eyebrow}</p>}
    {headline && <h2 class="mdgh-become__headline">{headline}</h2>}
    {body && <p class="mdgh-become__body">{body}</p>}
    {cta?.label && cta?.href && (
      <div class="mdgh-become__cta">
        <Button variant={cta.variant ?? 'primary'} href={cta.href}>{cta.label}</Button>
      </div>
    )}
  </div>
</section>

<style>
  .mdgh-become {
    min-height: 90vh;
    display: grid;
    place-items: center;
    padding: var(--space-9) var(--space-6);
    background:
      radial-gradient(50% 60% at 50% 30%, rgba(255, 209, 102, 0.15), transparent 70%),
      linear-gradient(180deg, var(--color-deep-violet), var(--color-obsidian));
  }

  .mdgh-become__inner {
    max-width: 800px;
    text-align: center;
  }

  .mdgh-become__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-saffron);
    margin: 0 0 var(--space-5);
  }

  .mdgh-become__headline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 400;
    line-height: 1;
    margin: 0 0 var(--space-4);
    background: linear-gradient(120deg, var(--color-bone), var(--color-saffron) 60%, var(--color-rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .mdgh-become__body {
    color: var(--color-text-2);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.6;
    margin: 0 auto;
    max-width: 640px;
  }

  .mdgh-become__cta {
    margin-top: var(--space-6);
  }
</style>
